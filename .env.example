# PDF-to-Excel Converter Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Required: AI Parser Keys
# ===========================================

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model to use (options: gpt-4o, gpt-4o-mini, gpt-4-turbo)
# gpt-4o-mini is the most cost-effective for this use case
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key - Get from https://console.anthropic.com/
# Used for template detection (Claude Haiku) - lower cost alternative
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ===========================================
# Required: Database
# ===========================================

# PostgreSQL connection URL.
# Production requires this. Local development defaults to sqlite:///local.db if unset.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===========================================
# Required: Flask Configuration
# ===========================================

# Secret key for Flask sessions (generate a random string)
SECRET_KEY=your-secret-key-change-in-production

# Public origin for canonical tags, sitemap, robots.txt, og/JSON-LD URLs.
# MUST be absolute with scheme (scheme-less values are normalized to https://
# by site_urls.py, but set it correctly). Unset locally = request host.
CANONICAL_BASE_URL=https://multistatementpdftoexcel.online

# Port to run the app on
PORT=5001

# Railway service role: web, worker, or scheduler (run exactly one scheduler)
SERVICE_ROLE=web

# Set to true in production (HTTPS only)
SESSION_COOKIE_SECURE=false

# ===========================================
# Required: Redis
# ===========================================

# Redis URL for Celery task queue
REDIS_URL=redis://localhost:6379/0

# Block rate-limited endpoints if Redis is unavailable in production
RATE_LIMIT_FAIL_CLOSED=true

# ===========================================
# Required: Email (Resend)
# ===========================================

# Resend API Key - Get from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Sender email address (must be from a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# Required: AWS (Storage)
# ===========================================

# AWS credentials
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# AWS S3 / R2 - File storage
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ENDPOINT_URL=                          # Leave empty for AWS S3; set for R2/MinIO

# Shared storage path (for Railway volume or local disk)
SHARED_STORAGE_PATH=

# ===========================================
# Auth & User Management
# ===========================================

# Magic link expiration in minutes (default: 15)
MAGIC_LINK_EXP_MINUTES=15

# Comma-separated list of admin emails
ADMIN_EMAILS=admin@yourdomain.com

# ===========================================
# Quotas & Rate Limits
# ===========================================

# Guest conversion limit (default: 1)
GUEST_CONVERSION_LIMIT=1

# Registered user conversion limit (default: 5, used for free plan)
USER_CONVERSION_LIMIT=5

# Set to true to disable all quota checks
DISABLE_QUOTAS=false

# Max pages per document (default: 250)
MAX_PAGES=250

# File size cap in MB. The public product maximum is 50 MB for every plan.
MAX_UPLOAD_MB=50

# Destination offered when a PDF exceeds the size or page limit
FILE_SPLITTER_URL=https://smallpdfsplit.online/

# Protect inputs for recent queued/processing jobs from local cleanup
ACTIVE_UPLOAD_GRACE_HOURS=24

# Rate limits (per IP)
RATE_LIMIT_CONVERT=15                      # Conversions per hour (default: 15)
RATE_LIMIT_STATUS=120                      # Status polls per minute (default: 120)

# ===========================================
# Stripe Payments
# ===========================================

# Stripe API keys - Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook secret - Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for subscription plans
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ===========================================
# Analytics (Optional)
# ===========================================

# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (optional)
GTM_CONTAINER_ID=

# ===========================================
# Feature Flags (Optional)
# ===========================================

# Emergency language gate. Leave disabled unless non-English scripts must be rejected.
ENGLISH_ONLY_BETA=false

# Feedback auto-cleanup in days (default: 30)
FEEDBACK_RETENTION_DAYS=30
FEEDBACK_RETENTION_SWEEP_MINS=60

# First-party analytics retention for admin portal visit/login logs
FIRST_PARTY_ANALYTICS_RETENTION_DAYS=180
FIRST_PARTY_ANALYTICS_SWEEP_MINS=1440

# S3 result file retention in hours (default: 24, 0 = never delete)
S3_RESULT_RETENTION_HOURS=24

# ===========================================
# Parser Tuning (Optional)
# ===========================================

# Execution preset (leave empty for auto-detection)
EXECUTION_PRESET=

# Enable enhanced ONNX OCR for scanned PDFs (legacy flag name; default: true)
USE_PADDLEOCR=true

# Large document chunking
CHUNK_ORCHESTRATION_ENABLED=true
CHUNK_ORCHESTRATION_MIN_PAGES=80           # Min pages to trigger chunking
CHUNK_SIZE_PAGES=40                        # Pages per chunk

# LLM safety guards
LLM_MAX_OUTPUT_TOKENS=4096                 # Max tokens per LLM extraction request
LLM_REQUEST_TIMEOUT=60                     # Timeout in seconds per LLM API call
