# PDF-to-Excel Converter Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Required for Universal (AI) Parser
# ===========================================

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model to use (options: gpt-4o, gpt-4o-mini, gpt-4-turbo)
# gpt-4o-mini is the most cost-effective for this use case
OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Flask Configuration
# ===========================================

# Secret key for Flask sessions (generate a random string)
SECRET_KEY=your-secret-key-change-in-production

# Port to run the app on
PORT=5001

# ===========================================
# Optional: Redis for Production
# ===========================================

# Redis URL for Celery task queue (required for local development)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# SaaS Configuration (Optional)
# ===========================================

# Maximum pages per document (default: 100)
MAX_PAGES_PER_DOC=100

# Maximum file size in MB (default: 20)
MAX_FILE_SIZE_MB=20
